<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ApkRenamer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_deep</item>
        <item name="colorPrimaryDark">@color/brand_deep</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_oncontainer</item>
        <item name="colorTertiary">@color/accent</item>
        <item name="colorOnTertiary">@color/on_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <!--
            statusBarColor 在 API 35 上被系统忽略（状态栏强制透明），但 API 34 及以下仍然生效，
            因此**保留不删**。API 35 上的品牌青顶栏由吃掉 top inset 后向上延伸的 MaterialToolbar
            承担，视觉与 targetSdk 34 时一致。toolbar_bg 日/夜各自取值，两种模式下顶栏都是深色，
            状态栏图标恒为浅色。
        -->
        <item name="android:statusBarColor" tools:targetApi="21">@color/toolbar_bg</item>
        <!-- 顶栏是深色品牌青，状态栏图标保持浅色 -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- 关掉系统给透明系统栏自动叠加的半透明遮罩 -->
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowBackground">@color/bg_window</item>
    </style>

    <style name="BadgeText">
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textColor">@color/brand_oncontainer</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
